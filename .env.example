# Copy to your shell (there is no .env loader) or `export` these before `npm run dev`.
# Only uncomment the values you want to override; the defaults are shown.

# PORT=3000
# DB_FILE=data/etf-viewer.sqlite

# Leave empty to use the FundFacts keyless demo endpoint.
# FUNDFACTS_API_KEY=your-api-key
# FUNDFACTS_BASE_URL=https://fundfactsapi.com/api/v1

# FUND_CACHE_TTL_MS=86400000
# UPSTREAM_TIMEOUT_MS=30000

# Testing/demo only; never enable in production.
# ENABLE_SNAPSHOT_FALLBACK=1

# Vite dev-server proxy target for /api.
# API_URL=http://localhost:3000
